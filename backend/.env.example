ENVIRONMENT=development
DEBUG=true

# Full SQLAlchemy database URL. For local dev without Docker, point this at
# a Postgres instance you control. For Neon/Render in production, use the
# connection string they provide (psycopg driver, sslmode=require recommended).
DATABASE_URL=postgresql+psycopg://csuser:devpassword@localhost:5432/construction_store

# Generate a real secret for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]
